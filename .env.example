# ============================================================
#  Personable（标签人间）— 书签人格卡 MVP — 配置（单一来源，可随时改）
#  实际部署时复制为 .env 并填好 LLM_API_KEY（.env 已被 gitignore）
#  注意：本文件是模板，会被提交，切勿在此填真实密钥！
# ============================================================

# --- 凭据（仅服务端，绝不下发客户端；OpenAI 兼容协议）---
LLM_API_KEY=
# DashScope 兼容模式 base（结尾到 /compatible-mode/v1 即可，SDK 自动拼 /chat/completions）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 特性开关 / 回滚 ---
# false 时 agent 端点返回「已暂停」，前端与信息页仍可用
AGENT_ENABLED=true

# --- 全局每日预算（熔断开关）---
# >>> 想加/减额度，改这一行就行 <<<
# 每天最多允许多少次完整 agent 运行；用完当天返回「临时暂停」，次日自动恢复
DAILY_RUN_BUDGET=100
# 单次运行的 token 硬上限（成本天花板，防单次跑飞）
PER_RUN_MAX_TOKENS=120000

# --- 输入上限 ---
# 送去处理的最大书签条目数，超出做分层下采样
MAX_BOOKMARK_ENTRIES=800
# 请求体最大字节数（LLM 调用前就拒绝超大载荷）
MAX_REQUEST_BYTES=2000000

# --- agent 循环边界 ---
MAX_PAGE_FETCHES=8          # 单次运行最多抓取的代表性网页数
MAX_AGENT_ITERATIONS=24     # 工具调用循环最大迭代数
MAX_WALL_CLOCK_MS=90000     # 单次运行墙钟超时（毫秒）
FETCH_TIMEOUT_MS=8000       # 单个网页抓取超时（毫秒）
FETCH_MAX_BYTES=1500000     # 单个网页抓取体积上限

# --- 模型分层 ---
MODEL_TRIAGE=qwen-plus        # 聚类 + 深挖循环（快，无推理膨胀）
MODEL_SYNTHESIS=qwen3.5-plus  # 最终人格合成（被截图的文案，用好模型）

# --- 限流 ---
RATE_LIMIT_WINDOW_MS=600000  # 滑动窗口长度（毫秒）
RATE_LIMIT_MAX=5             # 每窗口每 IP 最大请求数
MAX_CONCURRENT_RUNS=3        # 全局并发运行上限

# --- 分享卡存储（自托管在 ECS）---
CARD_TTL_DAYS=7              # 分享卡留存天数
# 开发用 memory（进程内，重启即失）；ECS 生产改 sqlite（同机持久、自带清扫）
STORE_DRIVER=memory          # memory | sqlite
STORE_PATH=./data/cards.db   # sqlite 文件路径（STORE_DRIVER=sqlite 时生效）
